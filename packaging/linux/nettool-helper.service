[Unit]
Description=Network Engineering Toolkit Privileged Helper
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=simple
User=root
Group=nettool
RuntimeDirectory=nettool
RuntimeDirectoryMode=0770
StateDirectory=nettool/helper
StateDirectoryMode=0700
EnvironmentFile=/etc/nettool/helper.env
ExecStart=/usr/libexec/nettool-helper --socket /run/nettool/helper.sock --allow-uid ${NETTOOL_AGENT_UID} --state-dir /var/lib/nettool/helper --hosts-file /etc/hosts --nmcli /usr/bin/nmcli
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/hosts /var/lib/nettool/helper /run/nettool /sys/bus/pci/devices /sys/bus/pci/drivers /sys/bus/pci/drivers_probe /sys/kernel/mm/hugepages /sys/devices/system/node
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
